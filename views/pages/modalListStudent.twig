<div class="box-imputation">
	<div class="table-container">
		<h2>Liste des élèves</h2>

		<h3>
			{# On parcourt les classes pour afficher le nombre d’élèves de la classe actuellement sélectionnée. #}
			{% for nbStud in nbStudentByClassroom %}
				{% if selectedClassroom == nbStud.classroom_id %}
					{# Si la classe sélectionnée correspond à l’ID de la classe dans nbStudentByClassroom, on affiche le nombre d’élèves.
									selectedClassroom vient de la fonction newImputation  #}
					<p>Nombre d'élève :
						{{ nbStud._count.id }}</p>
				{% endif %}
			{% endfor %}
		</h3>

		<table class="table">
			<thead>
				<tr>
					<th>Nom</th>
					<th>Prénom</th>
					<th>Date de naissance</th>
					<th>Présent</th>
					<th>Absent</th>
					{% for student in students %}
						{# On ajoute une colonne Modifier seulement si l’élève a déjà une imputation aujourd’hui. #}
						{% if student.imputations|length > 0%}
							{% if loop.first %} {# On vérifie si c’est le premier élève de la liste pour ne pas répéter la colonne Modifier #}
								<th>Modifier</th>
							{% endif %}
						{% endif %}
					{% endfor %}
				</tr>
			</thead>

			<tbody>
				{% if errorSelect %}
					<div class="messError">
						{{errorSelect}}
					</div>
				{% endif %}
				{% for student in students %}
					<tr>
						<td>{{ student.lastname }}</td>
						<td>{{ student.firstname }}</td>
						<td>{{ student.birthday|date("d-m-Y") }}</td>

						{# Colonne Présent : permet au professeur de marquer un élève comme présent #}
						<td>
							{# On vérifie si student.imputations contient au moins un élément : cela signifie qu’une imputation existe déjà pour aujourd’hui.
							Si l'élève à déjà une imputation, on affiche soit le résultat, soit le bouton de modification #}
							{% if student.imputations|length > 0 %}
								{% if updateImputation and updateImputation.student_id == student.id %}
									{# Si l’élève est en cours de modification, on affiche à nouveau les boutons pour changer son statut, 
									updateImputation = l’imputation que je veux modifier, updateImputation.student_id = est l'élève concerné, student.id = l’élève de la ligne actuelle  #}
									<form action="/imputation/update/{{ updateImputation.id }}" method="post">
										<input type="hidden" name="imputation" value="true">
										<input type="hidden" name="classroom_id" value="{{ selectedClassroom }}">
										<button id="isPresent">Présent</button>
									</form>

								{% else %}
									{# Sinon, on affiche seulement le résultat déjà enregistré : ✅ présent ou - sans changement #}
									{% if student.imputations[0].isPresent %} {# student.imputations[0] = la première imputation de l'élève car je recupere uniquement l'imputation du jour #}
										<p style="font-size:20px;">✅</p>

									{% else %}
										<p>-</p>
									{% endif %}
								{% endif %}

								{# Aucune imputation aujourd’hui : on crée une nouvelle saisie #}
							{% else %}
								<form action="/imputation" method="post">
									<input
									type="hidden" name="imputation" value="true">
									{# on met la valeur true pour l’imputation, car le bouton Présent va envoyer la valeur true #}
									<input type="hidden" name="student_id" value="{{ student.id }}">
									<input type="hidden" name="classroom_id" value="{{ selectedClassroom }}">
									<button id="isPresent">Présent</button>
								</form>
							{% endif %}
						</td>

						{# Colonne Absent : permet au professeur de marquer un élève comme absent #}
						<td>
							{# On vérifie si student.imputations contient au moins un élément : cela signifie qu’une imputation existe déjà pour aujourd’hui. 
														Si l'élève à déjà une imputation, on affiche soit le résultat, soit le bouton de modification #}
							{% if student.imputations|length > 0 %}

								{% if updateImputation and updateImputation.student_id == student.id %}
									{# Si l’élève est en cours de modification, on affiche les boutons pour changer son état en absent #}
									<form action="/imputation/update/{{ updateImputation.id }}" method="post">
										<input type="hidden" name="imputation" value="false">
										<input type="hidden" name="classroom_id" value="{{ selectedClassroom }}">
										<button id="isAbsent">Absent</button>
									</form>

								{% else %}
									{% if not student.imputations[0].isPresent %}
										{# Si l’élève est déjà marqué comme absent, on affiche le résultat : ❌ absent #}
										<p style="font-size:20px;">❌</p>
									{% else %}
										<p>-</p>
									{% endif %}
								{% endif %}

								{# Aucune imputation aujourd’hui : on crée une nouvelle saisie #}
							{% else %}
								<form action="/imputation" method="post">
									<input type="hidden" name="imputation" value="">
									{# On laisse la valeur vide pour l’imputation, car le bouton Absent va envoyer la valeur false #}
									<input type="hidden" name="student_id" value="{{ student.id }}">
									<input type="hidden" name="classroom_id" value="{{ selectedClassroom }}">
									<button id="isAbsent">Absent</button>
								</form>
							{% endif %}
						</td>

						{# Bouton Modifier : permet au professeur de revenir sur la saisie pour corriger l’imputation #}
						<td>
							{% if student.imputations|length > 0 %}
								<form
									action="/imputation/update/{{ student.imputations[0].id }}" method="get">
									{# On récupère l’ID de l’imputation pour pouvoir la modifier dans la route /imputation/update/:id #}
									<button>Modifier</button>
								</form>
							{% endif %}
						</td>

					</tr>
				{% endfor %}
			</tbody>
		</table>

		<button type="button" id="close">Fermer</button>
	</div>
</div>
