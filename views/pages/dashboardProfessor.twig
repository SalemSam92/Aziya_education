{% extends "../layouts/base.twig" %}
{% block style %}
	<link rel="stylesheet" href="/css/headerDashboard.css">
	<link rel="stylesheet" href="/css/dashboardDirector.css">
	<link rel="stylesheet" href="/css/table.css">
	<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.css" rel="stylesheet"/>

{% endblock %}

{% block header %}
	{% include "../partials/headerDashboard.twig" %}
{% endblock %}
{% block main %}
	<div class="container">
		<div class="sideBar">


			<p class="nameUser">Bonjour
				{{user.lastname}}
				{{user.firstname}}</p>

			<p class="nameSchool">Etablissement:
				{{user.school.name}}
			</p>
			<p class="info">
				<b>Professeur de la classe :</b>
				{% for classroom in professorWithClassroom %}
					{% if classroom.professor_id == user.id %} {# On vérifie que la classe appartient bien au professeur connecté #}
						<b>{{classroom.name}}</b><br>

					{% endif %}
				{% endfor %}
			</p>
			<p></p>

		</div>

		<div class="center">
			<h2>Liste des élèves</h2>
			<p>Cliquez sur le bouton ci-dessous pour choisir la classe et afficher la liste des élèves</p>


			{#Formulaire pour sélectionner une classe et afficher la liste des élèves #}
			<form action="/dashboardProfessor" method="post">

				<select name="classroom_id" id="">
					<option value="">----Sélectionner une classe----</option>
					{% for classroom in professorWithClassroom %}
						{% if classroom.professor_id == user.id  %}{# On vérifie que la classe appartient bien au professeur connecté #}
							<option value="{{classroom.id}}">
								{{classroom.name}}
							</option>
						{% endif %}
					{% endfor %}

				</select>
				<div>
					<button type="submit" id="btn-choice-classroom">Valider</button>
				</div>
			</form>
			<p>Cliquez sur le bouton ci-dessous pour accéder à l'historique d'absence par élève</p>



			{# Formulaire pour sélectionner un élève et accéder à son historique d'absence #}
			<form action="/dashboardProfessor/{{studentId.id}}" method="post">

				<select name="student_id" id="">
					<option value="">----Sélectionner un élève----</option>
					{% for classroom in listStudentByProfessor %}
						{# listStudentByProfessor = liste de classes et classroom = une classe #}
						{% for student in classroom.student %}
							{# classroom.student = liste d'élèves #}
							<option value="{{student.id}}">
								{{student.lastname}}
								{{student.firstname}}
							</option>
						{% endfor %}
					{% endfor %}
				</select>
				<div>
					<button type="submit" id="btn-choice-student">Valider</button>
				</div>

			</form>
		</div>
	

{# modal pour afficher la liste des élèves d'une classe #}
		{% if modal %}
			<div class="modal-list-student" id="modal-list-student">
				<div class="modal-container">
					{% include "../pages/modalListStudent.twig" %}
				</div>
			</div>
		{% endif %}
		
		{# modal pour afficher le calendrier des absences d'un élève #}
		{% if modalCalendar %}
			<div class="modal-list-student" id="">
				<div class="modal-container">
					{% include "../pages/modalCalendar.twig" %}
				</div>
			</div>
		{% endif %}

		


		{% block script %}
			<script src="/scripts/modalDashboardProfessor.js"></script>
			<script src="/scripts/calendar.js"></script>
			<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"></script>
			<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/locales/fr.global.min.js"></script>
		{% endblock %}
	{% endblock %}
