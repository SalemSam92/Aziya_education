{% extends "../layouts/base.twig" %}


{% block style %}
	<link rel="stylesheet" href="css/headerRegisterLogin.css">
	<link rel="stylesheet" href="css/login.css">
	<link rel="stylesheet" href="css/footer.css">
{% endblock %}

{% block header %}
	{% include "../partials/headerRegisterLogin.twig" %}
{% endblock %}

{% block main %}


	<div class="box">
		<h2>Nouveau mot de passe</h2>

		<form action="" method="POST">
			<label for="mail">E-mail</label>
			<input type="mail" id="mail" name="mail" placeholder="dupont@gmail.com" autofocus>

			<label for="password">Nouveau mot de passe</label>
			<input type="password" id="password" name="password" placeholder="********">

			<button type="submit">Valider</button>

		</form>
        <p class="register">Pas encore inscrit?
				<a href="/register">S'inscrire ici</a><br>
				<a href="/login">Se connecter</a>
			</p>
		{% if errorNewPassword %}
			<div class="messError">
				{{errorNewPassword}}
			</div>
		{% endif %}
        {% if succesChangePassword %}
			<div class="messSucces">
				{{succesChangePassword}}
			</div>
		{% endif %}

        
		
	</div>
{% endblock %}
