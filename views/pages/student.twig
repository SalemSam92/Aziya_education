{% extends "../layouts/base.twig" %}

{% block style %}
	<link rel="stylesheet" href="/css/headerDashboard.css">
	<link rel="stylesheet" href="/css/dashboardDirector.css">
	<link rel="stylesheet" href="/css/table.css">
	<link rel="stylesheet" href="/css/footer.css">
{% endblock %}

{% block header %}
	{% include "../partials/headerDashboard.twig" %}
{% endblock %}


{% block main %}


	<div class="container">
		<div class="sideBar">


			<p class="nameUser">
				{{user.lastname}}
				{{user.firstname}}</p>

			<p class="nameSchool">Etablissement:
				{{user.school.name}}
			</p>


			<p>
				<a href="/dashboardDirector">Tableau de bord</a>
			</p>
			<p>
				<a href="/professor">Professeurs</a>
			</p>
			<p>
				<a href="/classroom">Classes</a>
			</p>

		</div>


		<div class="center">
			<div class="table-container">
				<h2>Liste des élèves</h2>
				<p>Gérer les informations des élèves en toute simplicité</p>
				<table class="table">
					<thead>
						<tr>
							<th>Nom</th>
							<th>Prénom</th>
							<th>Date de naissance</th>
							<th>Classes</th>
							<th>Modifier</th>
							<th>Supprimer</th>
							{% for student in students %}
								{% if updateStudent == student.id %}
									<th>Retirer affection</th>
								{% endif %}
							{% endfor %}
						</tr>
					</thead>

					<tbody>
						{% for student in students %}
							<tr>
								<form action="/student/{{student.id}}/updateStudent" method={% if updateStudent == student.id %} "post" {% else %} "get" {% endif %}>
									<td>
										{% if updateStudent == student.id %}
											<input type="text" name="lastname" value="{{student.lastname}}">
										{% else %}
											{{student.lastname}}
										{% endif %}

									</td>
									<td>
										{% if updateStudent == student.id %}
											<input type="text" name="firstname" value="{{student.firstname}}">
										{% else %}
											{{student.firstname}}
										{% endif %}

									</td>
									<td>
										{% if updateStudent == student.id %}
											<input type="date" name="birthday" value="{{student.birthday|date("Y-m-d")}}">
										{% else %}
											{{student.birthday|date("d/m/Y")}}
										{% endif %}

									</td>
									<td>
										{% if updateStudent == student.id %}

											{% for classroom in capaciteMaxClassroom if classroom.nbMaxStudent > classroom.student.length %}
												{# le if ici sert a filtrer la boucle avant qu'elle commence #}
												{# loop existe automatiquement dans chaque boucle for #}
												{# loop =infos sur la boucle, loop.first =première itération, loop.last =dernière itération #}

												{% if loop.first %}{# Premiere élément - ouverture du <select> #} 
													<select name="classroom_id">
														
													{% endif %}

													<option value="{{ classroom.id }}">{{ classroom.name }}</option>

													{% if loop.last %}{# Dernier élément - fermeture du <select> #}
													</select>
												{% endif %}

											{% else %}
												<p>Pas de classe disponible</p>
											{% endfor %}

										{% else %}
											{{ student.classroom }}
										{% endif %}
									</td>
									<td>
										<button class="{% if updateStudent == student.id %}btn-validate{% endif %}">
											{% if updateStudent == student.id %}
												Valider
											{% else %}
												Modifier
											{% endif %}
										</button>
									</td>
								</form>
								<td>
									<form action="student/{{student.id}}/deleteStudent" method="post">
										<button class="btn-delete">Supprimer</button>
									</form>
								</td>
								<td>
									{% if  updateStudent == student.id  %}
										<form action="/student/{{student.id}}/deleteAffectation" method="post">
										<input type="hidden" name = "classroom_id" value = "{{student.classroomId}}">
											<button class="btn-delete">retirer affection</button>
										</form>

									{% endif %}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</tbody>
			</table>
		</div>
		{% if errorUpdate %}
					<div class="messError">
						{{errorUpdate}}
					</div>
				{% endif %}
					{% if messSucces %}
					<div class="messSucces">
						{{messSucces}}
					</div>
				{% endif %}	
	</div>
{% endblock %}
