{% extends "../layouts/base.twig" %}


{% block style %}
	<link rel="stylesheet" href="css/headerRegisterLogin.css">
	<link rel="stylesheet" href="css/login.css">
	<link rel="stylesheet" href="css/footer.css">
{% endblock %}

{% block header %}
	{% include "../partials/headerRegisterLogin.twig" %}
{% endblock %}

{% block main %}


	<div class="box">
		<h2>Réinitialiser mot de passe</h2>

		<form action="/newPassword" method="POST">
			<input type="hidden" name="token" value="{{ token }}">
			<label for="mail">E-mail</label>
			<input type="mail" id="mail" name="mail" placeholder="dupont@gmail.com" autofocus>

			<button type="submit">Réinitialiser</button>

		</form>
		<p class="register">Pas encore inscrit?
			<a href="/register">S'inscrire ici</a><br>
			<a href="/login">Se connecter</a>
		</p>
		{% if errorUser %}
			<div class="messError">
				{{errorUser}}
			</div>
		{% endif %}
	


	</div>
{% endblock %}
